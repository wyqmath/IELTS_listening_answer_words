# Public files are explicit. Local notes, reports and generated state stay here.
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/README.en.md
!/使用说明.md
!/package.json
!/package-lock.json
!/index.html
!/app.js
!/styles.css
!/打开网页.cmd
!/启动本地预览.cmd

!/assets/
/assets/*
!/assets/icon.svg

!/data/
/data/*
!/data/vocab.json
!/data/vocab.js

!/examples/
/examples/*
!/examples/source.json
!/examples/vocab.json

!/tools/
/tools/*
!/tools/*.py
!/tools/*.cjs
!/tools/README.md
!/tools/README.en.md

# Never publish local credentials, original notes, backups or study records.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.log
*.tmp
*.bak
**/__pycache__/
*.py[cod]
/private/
/reports/
/node_modules/
/dist/
/build/
/tmp/
/.tmp/

# Editor / operating-system files.
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
