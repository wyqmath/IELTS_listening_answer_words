# Public files are explicit. Local notes, reports and generated state stay here.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.zh-CN.md
!/index.html

!/app/
/app/*
!/app/app.js
!/app/styles.css
!/app/assets/
/app/assets/*
!/app/assets/icon.svg
!/app/data/
/app/data/*
!/app/data/vocab.json
!/app/data/vocab.js

!/tools/
/tools/*
!/tools/*.py
!/tools/*.cjs
!/tools/README.md
!/tools/README.zh-CN.md
!/tools/package.json
!/tools/package-lock.json
!/tools/打开网页.cmd
!/tools/启动本地预览.cmd
!/tools/examples/
/tools/examples/*
!/tools/examples/source.json
!/tools/examples/vocab.json

# Never publish local credentials, original notes, backups or study records.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.log
*.tmp
*.bak
**/__pycache__/
*.py[cod]
/private/
/reports/
**/node_modules/
/dist/
/build/
/tmp/
/.tmp/

# Editor / operating-system files.
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
